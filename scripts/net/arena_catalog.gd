const MAPS := {
	"ruins": {"name": "Ruined District", "layout": RUINS},
	"colosseum": {"name": "The Colosseum", "layout": COLOSSEUM},
	"cathedral": {"name": "The Cathedral", "layout": CATHEDRAL},
	"pinwheel": {"name": "The Pinwheel", "layout": PINWHEEL},
	"bunker": {"name": "The Bunker", "layout": BUNKER},
}


static func ids() -> Array:
	return MAPS.keys()


static func layout(id: String) -> PackedStringArray:
	return PackedStringArray(MAPS.get(id, MAPS[DEFAULT])["layout"])


static func title(id: String) -> String:
	return MAPS.get(id, MAPS[DEFAULT])["name"]


## A random arena, never the one `avoid` names (so back-to-back matches differ).
static func pick(avoid := "") -> String:
	var options := ids()
	options.erase(avoid)
	return options.pick_random() if not options.is_empty() else DEFAULT
