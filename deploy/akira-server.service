[Unit]
Description=Akira game server
After=network-online.target
Wants=network-online.target

[Service]
User=akira
WorkingDirectory=/opt/akira
# Where Godot keeps its own small files (logs, cache) for this user.
Environment=HOME=/opt/akira
# The server's options live in /etc/akira/server.env, so changing the port or
# turning on TLS never means editing this file:  AKIRA_ARGS="--port=9050"
EnvironmentFile=/etc/akira/server.env
ExecStart=/opt/akira/akira_server --headless -- --server $AKIRA_ARGS
# Start again by itself if it ever crashes, and at every boot.
Restart=always
RestartSec=3
# Lets the unprivileged "akira" user listen on port 443 (and 80).
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
