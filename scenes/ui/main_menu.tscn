[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1"]

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Bg" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.03, 0.03, 0.04, 1)
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -120.0
offset_top = -110.0
offset_right = 120.0
offset_bottom = 110.0
theme_override_constants/separation = 14
alignment = 1

[node name="TitleLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32
text = "VOIDLIGHT"

[node name="SubtitleLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
autowrap_mode = 2
text = "You can only see as far as your light allows."

[node name="HighScoreLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
text = "High Score: 0"

[node name="StartButton" type="Button" parent="VBox"]
text = "Start"

[node name="QuitButton" type="Button" parent="VBox"]
text = "Quit"

[connection signal="pressed" from="VBox/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="VBox/QuitButton" to="." method="_on_quit_pressed"]
