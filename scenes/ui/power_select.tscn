[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/power_select.gd" id="1"]

[node name="PowerSelect" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Bg" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.03, 0.03, 0.04, 1)
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.05
anchor_right = 0.5
anchor_bottom = 0.95
offset_left = -260.0
offset_right = 260.0
theme_override_constants/separation = 14
alignment = 0

[node name="TitleLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28
text = "CHOOSE YOUR POWERS"

[node name="ModeRow" type="HBoxContainer" parent="VBox"]
alignment = 1
theme_override_constants/separation = 10

[node name="FFAButton" type="Button" parent="VBox/ModeRow"]
text = "Free-For-All"

[node name="TeamButton" type="Button" parent="VBox/ModeRow"]
text = "Team (coming soon)"
disabled = true

[node name="Columns" type="HBoxContainer" parent="VBox"]
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="P1Column" type="VBoxContainer" parent="VBox/Columns"]
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="P1Label" type="Label" parent="VBox/Columns/P1Column"]
horizontal_alignment = 1
text = "PLAYER 1"

[node name="PowerList" type="VBoxContainer" parent="VBox/Columns/P1Column"]
theme_override_constants/separation = 6

[node name="P2Column" type="VBoxContainer" parent="VBox/Columns"]
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="P2Label" type="Label" parent="VBox/Columns/P2Column"]
horizontal_alignment = 1
text = "PLAYER 2"

[node name="PowerList" type="VBoxContainer" parent="VBox/Columns/P2Column"]
theme_override_constants/separation = 6

[node name="BottomRow" type="HBoxContainer" parent="VBox"]
alignment = 1
theme_override_constants/separation = 10

[node name="BackButton" type="Button" parent="VBox/BottomRow"]
text = "Back"

[node name="StartButton" type="Button" parent="VBox/BottomRow"]
text = "Start Match"

[connection signal="pressed" from="VBox/ModeRow/FFAButton" to="." method="_on_ffa_pressed"]
[connection signal="pressed" from="VBox/ModeRow/TeamButton" to="." method="_on_team_pressed"]
[connection signal="pressed" from="VBox/BottomRow/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="VBox/BottomRow/StartButton" to="." method="_on_start_pressed"]
